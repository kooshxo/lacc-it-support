# Authentication: shared staff username is "Staff"; set its password only in a secret environment variable.
AUTH_SECRET=
STAFF_LOGIN_PASSWORD=

# Canonical Google Sheet for the production ticket queue.
DATA_BACKEND=google
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
WORKBOOK_OPERATOR_REFRESH_TOKEN=
EXCEL_DRIVE_ID=
EXCEL_WORKBOOK_ITEM_ID=
EXCEL_ATTACHMENTS_FOLDER_ITEM_ID=
EXCEL_INTAKE_TABLE_NAME=tblLegacyIntake

# Google Sheets access is scoped to the specific spreadsheet shared with this service account.
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_TAB_NAME=IT support request
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Vercel production uses keyless Workload Identity Federation; configure these values there.
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_WORKLOAD_IDENTITY_POOL_ID=
GOOGLE_WORKLOAD_IDENTITY_PROVIDER_ID=
# Optional only for environments where Google Cloud policy permits service-account keys.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional operational notifications through the same delegated operator.
NOTIFICATIONS_ENABLED=false
IT_NOTIFICATION_EMAIL=

# Development and automated-test fixture mode. Production refuses this mode.
AUTH_BYPASS=false
DEMO_USER_EMAIL=demo@example.org
DEMO_STAFF_NAME=IT Staff
