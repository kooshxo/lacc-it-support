# Authentication: Google sign-in restricted to the named IT staff.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
IT_STAFF_EMAILS=staff-one@example.org,staff-two@example.org

# Canonical Excel workbook (.xlsx in SharePoint or OneDrive for Business).
DATA_BACKEND=google
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
WORKBOOK_OPERATOR_REFRESH_TOKEN=
EXCEL_DRIVE_ID=
EXCEL_WORKBOOK_ITEM_ID=
EXCEL_ATTACHMENTS_FOLDER_ITEM_ID=
EXCEL_INTAKE_TABLE_NAME=tblLegacyIntake

# Optional Google Sheets completion sync (OAuth refresh token; no service-account key required)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_TAB_NAME=IT support request
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=

# Optional operational notifications through the same delegated operator.
NOTIFICATIONS_ENABLED=false
IT_NOTIFICATION_EMAIL=

# Development and automated-test fixture mode. Production refuses this mode.
AUTH_BYPASS=false
DEMO_USER_EMAIL=demo@example.org
DEMO_STAFF_NAME=IT Staff
